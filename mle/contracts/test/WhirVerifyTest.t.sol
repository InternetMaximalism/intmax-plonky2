    /// @notice The exact small_mul audit triple is committed into an honest
    /// packed-v1 proof. Replacing only its two derived packed claim cells with
    /// folds of the recorded AFTER constituents must fail at the production
    /// Solidity PCS boundary.
    function test_whir_historical_small_mul_after_only_rejected_at_pcs() public {
        _runHistoricalPcsCase(0);
    }

    /// @notice Same proof-dependent regression for the exact parent-validity
    /// audit triple. This is a PCS-layer fixture, not an attempt to grind the
    /// retired v0 outer Fiat-Shamir challenges into a fresh v1 transcript.
    function test_whir_historical_parent_validity_after_only_rejected_at_pcs() public {
        _runHistoricalPcsCase(1);
    }

    /// @notice Test that a tampered WHIR transcript fails verification.
    function test_whir_tampered_transcript_fails() public {
        string memory json = vm.readFile("test/fixtures/small_mul.json");

        // Parse the WHIR data (unified transcript)
        bytes memory transcript = vm.parseJsonBytes(json, ".whirTranscript");
        bytes memory hints = vm.parseJsonBytes(json, ".whirHints");
        bytes memory protocolId = vm.parseJsonBytes(json, ".whirProtocolId");
        bytes memory sessionId = vm.parseJsonBytes(json, ".whirSplitSessionId");

        // Build evaluations [preprocessed, witness]
        GoldilocksExt3.Ext3[] memory evaluations = _parseEvaluations(json);

        // Build WhirParams
        SpongefishWhirVerify.WhirParams memory params = _parseWhirParams(json);

        // Tamper with transcript (flip a byte in the middle)
        uint256 mid = transcript.length / 2;
        transcript[mid] = bytes1(uint8(transcript[mid]) ^ 0xFF);

        // Verification should fail
        bool success;
        try this.externalVerifyWhir(
            protocolId, sessionId, transcript, hints, evaluations, _parseRoots(json), params
        ) returns (
            bool result
        ) {
            success = result;
        } catch {
            success = false;
        }
        assertFalse(success, "Tampered transcript should fail WHIR verification");
    }

    function test_whir_bound_statement_rejects_ext3_root_and_point_mutations() public {
        string memory json = vm.readFile("test/fixtures/small_mul.json");
        bytes memory transcript = vm.parseJsonBytes(json, ".whirTranscript");
        bytes memory hints = vm.parseJsonBytes(json, ".whirHints");
        bytes memory protocolId = vm.parseJsonBytes(json, ".whirProtocolId");
        bytes memory sessionId = vm.parseJsonBytes(json, ".whirSplitSessionId");
        (GoldilocksExt3.Ext3[] memory evaluations, bytes memory mask) = _parseBoundStatement(json);
        assertEq(evaluations.length, 16, "packed statement must be 4 points x 4 groups");
        assertEq(mask.length, 2, "packed statement mask length");
        assertEq(uint8(mask[0]), 0x7b, "packed statement mask byte 0");
        assertEq(uint8(mask[1]), 0x34, "packed statement mask byte 1");
        bytes32[] memory roots = _parseRoots(json);
        SpongefishWhirVerify.WhirParams memory params = _parseWhirParams(json);

        assertTrue(
            this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params)
        );

        // Exercise every terminal-used point/group cell and every Ext3 limb.
        // The mask is the production 4-point x 4-group opening matrix; an
        // unmasked cell is deliberately not asserted by the outer protocol.
        for (uint256 slot = 0; slot < evaluations.length; slot++) {
            if ((uint8(mask[slot >> 3]) & uint8(1 << (slot & 7))) == 0) continue;
            GoldilocksExt3.Ext3 memory originalEvaluation = evaluations[slot];
            for (uint256 limb = 0; limb < 3; limb++) {
                if (limb == 0) {
                    evaluations[slot].c0 = uint64((uint256(originalEvaluation.c0) + 1) % P);
                } else if (limb == 1) {
                    evaluations[slot].c1 = uint64((uint256(originalEvaluation.c1) + 1) % P);
                } else {
                    evaluations[slot].c2 = uint64((uint256(originalEvaluation.c2) + 1) % P);
                }
                vm.expectRevert();
                this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
                evaluations[slot] = originalEvaluation;
            }
        }

        (roots[0], roots[1]) = (roots[1], roots[0]);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        (roots[0], roots[1]) = (roots[1], roots[0]);

        bytes32 originalRoot1 = roots[1];
        roots[1] = roots[0];
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        roots[1] = originalRoot1;

        bytes32[] memory shortRoots = new bytes32[](roots.length - 1);
        for (uint256 i = 0; i < shortRoots.length; i++) {
            shortRoots[i] = roots[i];
        }
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, shortRoots, params);

        bytes32[] memory extendedRoots = new bytes32[](roots.length + 1);
        for (uint256 i = 0; i < roots.length; i++) {
            extendedRoots[i] = roots[i];
        }
        extendedRoots[roots.length] = roots[0];
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, extendedRoots, params);

        GoldilocksExt3.Ext3[] memory shortEvaluations = new GoldilocksExt3.Ext3[](evaluations.length - 1);
        for (uint256 i = 0; i < shortEvaluations.length; i++) {
            shortEvaluations[i] = evaluations[i];
        }
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, shortEvaluations, mask, roots, params);

        GoldilocksExt3.Ext3[] memory extendedEvaluations = new GoldilocksExt3.Ext3[](evaluations.length + 1);
        for (uint256 i = 0; i < evaluations.length; i++) {
            extendedEvaluations[i] = evaluations[i];
        }
        extendedEvaluations[evaluations.length] = evaluations[0];
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, extendedEvaluations, mask, roots, params);

        bytes memory shortMask = new bytes(mask.length - 1);
        shortMask[0] = mask[0];
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, shortMask, roots, params);

        bytes memory wrongSessionId = bytes.concat(sessionId);
        wrongSessionId[0] = bytes1(uint8(wrongSessionId[0]) ^ 1);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, wrongSessionId, transcript, hints, evaluations, mask, roots, params);

        (params.evaluationPoint, params.evaluationPoint2) = (params.evaluationPoint2, params.evaluationPoint);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        (params.evaluationPoint, params.evaluationPoint2) = (params.evaluationPoint2, params.evaluationPoint);

        _reversePoint(params.evaluationPoint);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
    }

    /// @notice Complete the explicit reorder/reuse/mixing matrix around the
    /// grouped statement. Per-limb mutations and exact list shapes are covered
    /// above; this test targets attacks that preserve each element's encoding
    /// while moving it into a different semantic slot.
    function test_whir_bound_statement_rejects_reorder_reuse_and_cross_proof_mixing() public {
        string memory json = vm.readFile("test/fixtures/small_mul.json");
        bytes memory transcript = vm.parseJsonBytes(json, ".whirTranscript");
        bytes memory hints = vm.parseJsonBytes(json, ".whirHints");
        bytes memory protocolId = vm.parseJsonBytes(json, ".whirProtocolId");
        bytes memory sessionId = vm.parseJsonBytes(json, ".whirSplitSessionId");
        (GoldilocksExt3.Ext3[] memory evaluations, bytes memory mask) = _parseBoundStatement(json);
        bytes32[] memory roots = _parseRoots(json);
        SpongefishWhirVerify.WhirParams memory params = _parseWhirParams(json);
        assertTrue(
            this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params)
        );

        // Every root transposition and every directed cross-group reuse.
        for (uint256 left = 0; left < roots.length; left++) {
            for (uint256 right = left + 1; right < roots.length; right++) {
                (roots[left], roots[right]) = (roots[right], roots[left]);
                vm.expectRevert();
                this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
                (roots[left], roots[right]) = (roots[right], roots[left]);
            }
            for (uint256 source = 0; source < roots.length; source++) {
                if (source == left) continue;
                bytes32 original = roots[left];
                roots[left] = roots[source];
                vm.expectRevert();
                this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
                roots[left] = original;
            }
        }

        // A well-formed root from a different proof is still invalid in each
        // group slot. This is the concrete stale/new commitment-mixing case.
        bytes32[] memory otherRoots = _parseRoots(vm.readFile("test/fixtures/medium_mul.json"));
        for (uint256 group = 0; group < roots.length; group++) {
            assertTrue(otherRoots[group] != roots[group], "fixtures must have distinct roots");
            bytes32 original = roots[group];
            roots[group] = otherRoots[group];
            vm.expectRevert();
            this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
            roots[group] = original;
        }

        // Reordering or duplicating complete, canonical Ext3 claim values is
        // distinct from a malformed-limb attack and must also be rejected.
        assertTrue(!_extEq(evaluations[0], evaluations[1]), "fixture claims must be distinct");
        (evaluations[0], evaluations[1]) = (evaluations[1], evaluations[0]);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        (evaluations[0], evaluations[1]) = (evaluations[1], evaluations[0]);

        GoldilocksExt3.Ext3 memory originalEvaluation = evaluations[1];
        evaluations[1] = evaluations[0];
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        evaluations[1] = originalEvaluation;

        // Exercise permutations involving both additional terminal points,
        // beyond the primary/secondary swap covered by the preceding test.
        (params.additionalEvaluationPoints[0], params.additionalEvaluationPoints[1]) =
        (params.additionalEvaluationPoints[1], params.additionalEvaluationPoints[0]);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        (params.additionalEvaluationPoints[0], params.additionalEvaluationPoints[1]) =
        (params.additionalEvaluationPoints[1], params.additionalEvaluationPoints[0]);

        (params.evaluationPoint, params.additionalEvaluationPoints[0]) =
        (params.additionalEvaluationPoints[0], params.evaluationPoint);
        vm.expectRevert();
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        (params.evaluationPoint, params.additionalEvaluationPoints[0]) =
        (params.additionalEvaluationPoints[0], params.evaluationPoint);

        GoldilocksExt3.Ext3[] memory originalPoint = params.evaluationPoint;
        GoldilocksExt3.Ext3[] memory shortPoint = new GoldilocksExt3.Ext3[](originalPoint.length - 1);
        for (uint256 i = 0; i < shortPoint.length; i++) {
            shortPoint[i] = originalPoint[i];
        }
        params.evaluationPoint = shortPoint;
        vm.expectRevert(SpongefishWhirVerify.InvalidParameters.selector);
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);

        GoldilocksExt3.Ext3[] memory longPoint = new GoldilocksExt3.Ext3[](originalPoint.length + 1);
        for (uint256 i = 0; i < originalPoint.length; i++) {
            longPoint[i] = originalPoint[i];
        }
        longPoint[originalPoint.length] = originalPoint[0];
        params.evaluationPoint = longPoint;
        vm.expectRevert(SpongefishWhirVerify.InvalidParameters.selector);
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, mask, roots, params);
        params.evaluationPoint = originalPoint;

        bytes memory wrongProtocolId = bytes.concat(protocolId);
        wrongProtocolId[0] = bytes1(uint8(wrongProtocolId[0]) ^ 1);
        vm.expectRevert();
        this.externalVerifyWhirBound(wrongProtocolId, sessionId, transcript, hints, evaluations, mask, roots, params);

        bytes memory extendedMask = bytes.concat(mask, hex"00");
        vm.expectRevert(SpongefishWhirVerify.InvalidParameters.selector);
        this.externalVerifyWhirBound(protocolId, sessionId, transcript, hints, evaluations, extendedMask, roots, params);
    }

    /// @notice External wrapper for try/catch (Solidity requires external calls for try).
    function externalVerifyWhir(
        bytes memory protocolId,
        bytes memory sessionId,
        bytes memory transcript,
        bytes memory hints,
        GoldilocksExt3.Ext3[] memory evaluations,
        bytes32[] memory expectedRoots,
        SpongefishWhirVerify.WhirParams memory params
    ) external pure returns (bool) {
        bytes memory evaluationMask = new bytes((evaluations.length + 7) / 8);
        return SpongefishWhirVerify.verifyWhirProofBound(
            protocolId, sessionId, "", transcript, hints, evaluations, evaluationMask, expectedRoots, params
        );
    }

    function externalVerifyWhirBound(
        bytes memory protocolId,
        bytes memory sessionId,
        bytes memory transcript,
        bytes memory hints,
        GoldilocksExt3.Ext3[] memory evaluations,
        bytes memory mask,
        bytes32[] memory expectedRoots,
        SpongefishWhirVerify.WhirParams memory params
    ) external pure returns (bool) {
        return SpongefishWhirVerify.verifyWhirProofBound(
            protocolId, sessionId, "", transcript, hints, evaluations, mask, expectedRoots, params
        );
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Internal: parse fixture JSON and verify WHIR proof
    // ═══════════════════════════════════════════════════════════════════════

    function _runHistoricalPcsCase(uint256 caseIndex) internal {
        HistoricalPcsData memory data = _loadHistoricalPcsCase(caseIndex);
        _assertHistoricalHonestFolds(data);
        _verifyHistoricalBeforeThenAfter(data);
    }

    function _loadHistoricalPcsCase(uint256 caseIndex) internal view returns (HistoricalPcsData memory data) {
        string memory json = vm.readFile("test/fixtures/historical_pcs_triples.json");
        string memory paramsJson = vm.readFile("test/fixtures/small_mul.json");
        assertEq(vm.parseJsonUint(json, ".schemaVersion"), 1, "historical PCS fixture schema");
        assertEq(vm.parseJsonUint(json, ".degreeBits"), 2, "historical PCS row variables");
        assertEq(vm.parseJsonUint(json, ".constituentWidth"), HISTORICAL_WIDTH, "historical PCS width");
        assertEq(vm.parseJsonUint(json, ".numCommitments"), NUM_PCS_GROUPS, "historical PCS groups");
        assertEq(vm.parseJsonUint(json, ".numLinearForms"), NUM_PCS_TERMINAL_POINTS, "historical PCS points");
        assertEq(vm.parseJsonString(json, ".paramsFixture"), "small_mul.json", "historical PCS config source");

        data.protocolId = vm.parseJsonBytes(json, ".whirProtocolId");
        data.sessionId = vm.parseJsonBytes(json, ".whirSplitSessionId");
        assertEq(data.protocolId, vm.parseJsonBytes(paramsJson, ".whirProtocolId"), "historical PCS protocol id");
        assertEq(data.sessionId, vm.parseJsonBytes(paramsJson, ".whirSplitSessionId"), "historical PCS split session");

        string memory base = string.concat(".cases[", vm.toString(caseIndex), "]");
        HistoricalExpected memory expected = _historicalExpected(caseIndex);
        string memory expectedName = caseIndex == 0 ? "small_mul" : "parent validity";
        assertEq(vm.parseJsonString(json, string.concat(base, ".name")), expectedName, "historical PCS case");

        data.witnessBefore = _parseGoldilocksArray(json, string.concat(base, ".witnessBefore"));
        data.witnessAfter = _parseGoldilocksArray(json, string.concat(base, ".witnessAfter"));
        data.inverseBefore = _parseGoldilocksArray(json, string.concat(base, ".inverseBefore"));
        data.inverseAfter = _parseGoldilocksArray(json, string.concat(base, ".inverseAfter"));
        _assertHistoricalConstituents(
            data.witnessBefore, data.witnessAfter, data.inverseBefore, data.inverseAfter, expected, HISTORICAL_WIDTH
        );

        data.indexPoint =
            _parseHistoricalExt3Array(json, string.concat(base, ".indexPointAtInverse"), HISTORICAL_INDEX_BITS);
        data.evaluations = _parseHistoricalExt3Array(json, string.concat(base, ".honestEvaluations"), NUM_PCS_CLAIMS);
        data.transcript = vm.parseJsonBytes(json, string.concat(base, ".whirTranscript"));
        data.hints = vm.parseJsonBytes(json, string.concat(base, ".whirHints"));
        data.roots = _parseHistoricalRoots(json, base);
        data.params = _parseWhirParams(paramsJson);
        _setHistoricalPoints(data.params, json, base);
        assertEq(data.params.numVariables, 10, "historical PCS packed variables");
        assertEq(data.params.numVectors, 1, "historical PCS vectors per group");
        assertEq(data.params.numCommitments, NUM_PCS_GROUPS, "historical PCS config groups");
    }

    function _assertHistoricalHonestFolds(HistoricalPcsData memory data) internal pure {
        GoldilocksExt3.Ext3 memory witnessFold =
            PackedClaimLib.fold(data.witnessBefore, HISTORICAL_WIDTH, data.indexPoint);
        GoldilocksExt3.Ext3 memory inverseFold =
            PackedClaimLib.fold(data.inverseBefore, HISTORICAL_WIDTH, data.indexPoint);
        require(_extEq(data.evaluations[HISTORICAL_WITNESS_SLOT], witnessFold), "historical honest witness fold");
        require(_extEq(data.evaluations[HISTORICAL_INVERSE_SLOT], inverseFold), "historical honest inverse fold");
    }

    function _verifyHistoricalBeforeThenAfter(HistoricalPcsData memory data) internal {
        // Use the exact production MLE mask. Both historical target cells are
        // terminal-bound; the other transcript cells remain WHIR-verified.
        bytes memory mask = abi.encodePacked(PACKED_BOUND_CLAIM_MASK);
        bytes32 contextHash = _historicalContextHash(data);
        assertTrue(
            this.externalVerifyWhirBound(
                data.protocolId,
                data.sessionId,
                data.transcript,
                data.hints,
                data.evaluations,
                mask,
                data.roots,
                data.params
            ),
            "historical BEFORE packed-v1 proof"
        );

        GoldilocksExt3.Ext3[] memory forged = new GoldilocksExt3.Ext3[](data.evaluations.length);
        for (uint256 i = 0; i < data.evaluations.length; i++) {
            forged[i] = data.evaluations[i];
        }
        forged[HISTORICAL_WITNESS_SLOT] = PackedClaimLib.fold(data.witnessAfter, HISTORICAL_WIDTH, data.indexPoint);
        forged[HISTORICAL_INVERSE_SLOT] = PackedClaimLib.fold(data.inverseAfter, HISTORICAL_WIDTH, data.indexPoint);
        assertTrue(
            !_extEq(forged[HISTORICAL_WITNESS_SLOT], data.evaluations[HISTORICAL_WITNESS_SLOT]),
            "historical witness projection changed"
        );
        assertTrue(
            !_extEq(forged[HISTORICAL_INVERSE_SLOT], data.evaluations[HISTORICAL_INVERSE_SLOT]),
            "historical inverse projection changed"
        );
        for (uint256 i = 0; i < data.evaluations.length; i++) {
            if (i != HISTORICAL_WITNESS_SLOT && i != HISTORICAL_INVERSE_SLOT) {
                assertTrue(_extEq(forged[i], data.evaluations[i]), "non-historical packed claim changed");
            }
        }

        // InvalidMleProof is emitted by _phaseInitial while it compares the
        // caller's exact AFTER folds against the proof-bound BEFORE cells.
        // All configuration and all proof material are the honest baseline.
        vm.expectRevert(InvalidMleProof.selector);
        this.externalVerifyWhirBound(
            data.protocolId, data.sessionId, data.transcript, data.hints, forged, mask, data.roots, data.params
        );
        assertEq(_historicalContextHash(data), contextHash, "historical proof context mutated");
    }

    function _historicalExpected(uint256 caseIndex) internal pure returns (HistoricalExpected memory expected) {
        if (caseIndex == 0) {
            return HistoricalExpected({
                w0Before: 3_051_498_664_030_569_048,
                w0After: 3_051_498_664_030_569_049,
                w1: 78_509_372_807_566_819,
                w80Before: 6_063_719_204_085_150_528,
                w80After: 2_587_698_932_769_584_699,
                a0: 16_828_114_539_042_804_903,
                a1Before: 7_495_656_216_612_080_666,
                a1After: 14_584_819_668_673_277_578,
                b0: 13_178_207_313_111_168_954
            });
        }
        require(caseIndex == 1, "historical PCS case index");
        return HistoricalExpected({
            w0Before: 8_093_513_556_413_711_660,
