    function _setHistoricalPoints(SpongefishWhirVerify.WhirParams memory params, string memory json, string memory base)
        internal
        pure
    {
        params.evaluationPoint =
            _parseHistoricalExt3Array(json, string.concat(base, ".whirPoints[0]"), params.numVariables);
        params.evaluationPoint2 =
            _parseHistoricalExt3Array(json, string.concat(base, ".whirPoints[1]"), params.numVariables);
        params.additionalEvaluationPoints = new GoldilocksExt3.Ext3[][](2);
        params.additionalEvaluationPoints[0] =
            _parseHistoricalExt3Array(json, string.concat(base, ".whirPoints[2]"), params.numVariables);
        params.additionalEvaluationPoints[1] =
            _parseHistoricalExt3Array(json, string.concat(base, ".whirPoints[3]"), params.numVariables);
    }

    function _historicalContextHash(HistoricalPcsData memory data) internal pure returns (bytes32) {
        return keccak256(
            abi.encode(
                keccak256(data.transcript),
                keccak256(data.hints),
                data.roots,
                data.params.evaluationPoint,
                data.params.evaluationPoint2,
                data.params.additionalEvaluationPoints[0],
                data.params.additionalEvaluationPoints[1]
            )
        );
    }

    function _parseHistoricalExt3Array(string memory json, string memory path, uint256 length)
        internal
        pure
        returns (GoldilocksExt3.Ext3[] memory out)
    {
        out = new GoldilocksExt3.Ext3[](length);
        for (uint256 i = 0; i < length; i++) {
            string memory element = string.concat(path, "[", vm.toString(i), "]");
            out[i] = GoldilocksExt3.Ext3(
                uint64(_parseGoldilocks(json, string.concat(element, ".c0"))),
                uint64(_parseGoldilocks(json, string.concat(element, ".c1"))),
                uint64(_parseGoldilocks(json, string.concat(element, ".c2")))
            );
        }
    }

    function _verifyWhirFromFixture(string memory json) internal view {
        bytes memory transcript = vm.parseJsonBytes(json, ".whirTranscript");
        bytes memory hints = vm.parseJsonBytes(json, ".whirHints");
        bytes memory protocolId = vm.parseJsonBytes(json, ".whirProtocolId");
        bytes memory sessionId = vm.parseJsonBytes(json, ".whirSplitSessionId");

        console.log("WHIR transcript length:", transcript.length);
        console.log("WHIR hints length:", hints.length);
        console.log("Protocol ID length:", protocolId.length);

        // Parse evaluations [preprocessed, witness]
        GoldilocksExt3.Ext3[] memory evaluations = _parseEvaluations(json);
        console.log("Evaluation[0] c0:", evaluations[0].c0);

        // Parse WhirParams
        SpongefishWhirVerify.WhirParams memory params = _parseWhirParams(json);
        console.log("WHIR numVariables:", params.numVariables);
        console.log("WHIR foldingFactor:", params.foldingFactor);
        console.log("WHIR numRounds:", params.numRounds);
        console.log("WHIR numCommitments:", params.numCommitments);

        // Verify
        uint256 gasBefore = gasleft();
        bytes memory evaluationMask = new bytes((evaluations.length + 7) / 8);
        bool valid = SpongefishWhirVerify.verifyWhirProofBound(
            protocolId, sessionId, "", transcript, hints, evaluations, evaluationMask, _parseRoots(json), params
        );
        uint256 gasUsed = gasBefore - gasleft();
        console.log("WHIR verification gas:", gasUsed);

        assertTrue(valid, "WHIR verification should pass");
    }

    function _parseRoots(string memory json) internal pure returns (bytes32[] memory roots) {
        roots = new bytes32[](4);
        roots[0] = vm.parseJsonBytes32(json, ".preprocessedCommitmentRoot");
        roots[1] = vm.parseJsonBytes32(json, ".witnessCommitmentRoot");
        roots[2] = vm.parseJsonBytes32(json, ".inverseHelpersCommitmentRoot");
        roots[3] = vm.parseJsonBytes32(json, ".auxCommitmentRoot");
    }

    function _parseBoundStatement(string memory json)
        internal
        pure
        returns (GoldilocksExt3.Ext3[] memory evaluations, bytes memory mask)
    {
        uint256 width = vm.parseJsonUint(json, ".constituentWidth");
        GoldilocksExt3.Ext3[][] memory indexPoints = _derivePackedIndexPoints(json);
        // Four terminal points by four canonical commitment groups. Each
        // group is one packed vector; constituent slots are folded into its
        // single Ext3 claim after the index challenge is sampled.
        evaluations = new GoldilocksExt3.Ext3[](16);
        mask = new bytes((evaluations.length + 7) / 8);

        _bindPacked(
            evaluations, mask, _parseGoldilocksArray(json, ".preprocessedIndividualEvals"), 0, 0, width, indexPoints[0]
        );
        _bindPacked(
            evaluations, mask, _parseGoldilocksArray(json, ".witnessIndividualEvals"), 0, 1, width, indexPoints[0]
        );
        uint256[] memory auxiliary = new uint256[](2);
        auxiliary[0] = _parseGoldilocks(json, ".auxConstraintEval");
        auxiliary[1] = _parseGoldilocks(json, ".auxPermEval");
        _bindPacked(evaluations, mask, auxiliary, 0, 3, width, indexPoints[0]);

        _bindPacked(
            evaluations,
            mask,
            _parseGoldilocksArray(json, ".preprocessedIndividualEvalsAtRInv"),
            1,
            0,
            width,
            indexPoints[1]
        );
        _bindPacked(
            evaluations, mask, _parseGoldilocksArray(json, ".witnessIndividualEvalsAtRInv"), 1, 1, width, indexPoints[1]
        );
        _bindPacked(
            evaluations, mask, _parseGoldilocksArray(json, ".inverseHelpersEvalsAtRInv"), 1, 2, width, indexPoints[1]
        );
        _bindPacked(
            evaluations, mask, _parseGoldilocksArray(json, ".inverseHelpersEvalsAtRH"), 2, 2, width, indexPoints[2]
        );
        _bindPacked(
            evaluations,
            mask,
            _parseGoldilocksArray(json, ".preprocessedIndividualEvalsAtRGateV2"),
            3,
            0,
            width,
            indexPoints[3]
        );
        _bindPacked(
            evaluations,
            mask,
            _parseGoldilocksArray(json, ".witnessIndividualEvalsAtRGateV2"),
            3,
            1,
            width,
            indexPoints[3]
        );
    }

    function _bindPacked(
        GoldilocksExt3.Ext3[] memory evaluations,
        bytes memory mask,
        uint256[] memory values,
        uint256 point,
        uint256 group,
        uint256 width,
        GoldilocksExt3.Ext3[] memory indexPoint
    ) internal pure {
        uint256 slot = point * 4 + group;
        evaluations[slot] = PackedClaimLib.fold(values, width, indexPoint);
        mask[slot >> 3] = bytes1(uint8(mask[slot >> 3]) | uint8(1 << (slot & 7)));
    }

    function _reversePoint(GoldilocksExt3.Ext3[] memory point) internal pure {
        for (uint256 i = 0; i < point.length / 2; i++) {
            (point[i], point[point.length - 1 - i]) = (point[point.length - 1 - i], point[i]);
        }
    }

    function _extEq(GoldilocksExt3.Ext3 memory left, GoldilocksExt3.Ext3 memory right) internal pure returns (bool) {
        return left.c0 == right.c0 && left.c1 == right.c1 && left.c2 == right.c2;
    }

    function _parseEvaluations(string memory json) internal pure returns (GoldilocksExt3.Ext3[] memory) {
        uint256 numVectors = vm.parseJsonUint(json, ".whirParams.numVectors");
        uint256 numCommitments = vm.parseJsonUint(json, ".whirParams.numCommitments");
        // Four terminal points, group-major constituent rows. The zero mask
        // asks the standalone WHIR test to accept the transcript-bound values
        // as its public statement; MleE2ETest separately checks every terminal
        // coordinate used by the outer protocol.
        return new GoldilocksExt3.Ext3[](4 * numCommitments * numVectors);
    }

    /// @dev Parse a Goldilocks vector of length n from JSON string array.
    function _parseGoldilocksArray(string memory json, string memory path)
        internal
        pure
        returns (uint256[] memory out)
    {
        string[] memory strs = vm.parseJsonStringArray(json, path);
        out = new uint256[](strs.length);
        for (uint256 i = 0; i < strs.length; i++) {
            out[i] = vm.parseUint(strs[i]);
            require(out[i] < P, "fixture: non-canonical Goldilocks element");
        }
    }

    function _parseExactGoldilocksArray(string memory json, string memory path, uint256 expectedLength)
        internal
        pure
        returns (uint256[] memory out)
    {
        out = _parseGoldilocksArray(json, path);
        require(out.length == expectedLength, "fixture: Goldilocks array length");
    }

    function _parseGoldilocks(string memory json, string memory path) internal pure returns (uint256 value) {
        value = vm.parseUint(vm.parseJsonString(json, path));
        require(value < P, "fixture: non-canonical Goldilocks element");
    }

    function _parseWhirParams(string memory json) internal pure returns (SpongefishWhirVerify.WhirParams memory) {
        SpongefishWhirVerify.WhirParams memory params;

        params.numVariables = vm.parseJsonUint(json, ".whirParams.numVariables");
        params.foldingFactor = vm.parseJsonUint(json, ".whirParams.foldingFactor");
        params.numVectors = vm.parseJsonUint(json, ".whirParams.numVectors");
        params.numCommitments = vm.parseJsonUint(json, ".whirParams.numCommitments");
        params.outDomainSamples = vm.parseJsonUint(json, ".whirParams.outDomainSamples");
        params.inDomainSamples = vm.parseJsonUint(json, ".whirParams.inDomainSamples");
        params.initialSumcheckRounds = vm.parseJsonUint(json, ".whirParams.initialSumcheckRounds");
        params.numRounds = vm.parseJsonUint(json, ".whirParams.numRounds");
        params.finalSumcheckRounds = vm.parseJsonUint(json, ".whirParams.finalSumcheckRounds");
        params.finalSize = vm.parseJsonUint(json, ".whirParams.finalSize");
        params.initialCodewordLength = vm.parseJsonUint(json, ".whirParams.initialCodewordLength");
        params.initialMerkleDepth = vm.parseJsonUint(json, ".whirParams.initialMerkleDepth");
        params.initialDomainGenerator = uint64(vm.parseJsonUint(json, ".whirParams.initialDomainGenerator"));
        params.initialInterleavingDepth = vm.parseJsonUint(json, ".whirParams.initialInterleavingDepth");
        params.initialNumVariables = vm.parseJsonUint(json, ".whirParams.initialNumVariables");
        params.initialCosetSize = vm.parseJsonUint(json, ".whirParams.initialCosetSize");
        params.initialNumCosets = vm.parseJsonUint(json, ".whirParams.initialNumCosets");
        params.initialSumcheckPowThreshold =
            uint64(vm.parseUint(vm.parseJsonString(json, ".whirParams.initialSumcheckPowThreshold")));
        params.finalPowThreshold = uint64(vm.parseUint(vm.parseJsonString(json, ".whirParams.finalPowThreshold")));
        params.finalSumcheckPowThreshold =
            uint64(vm.parseUint(vm.parseJsonString(json, ".whirParams.finalSumcheckPowThreshold")));

        // Parse rounds array
        uint256 numRounds = params.numRounds;
        params.rounds = new SpongefishWhirVerify.RoundParams[](numRounds);
        for (uint256 i = 0; i < numRounds; i++) {
            string memory prefix = string.concat(".whirParams.rounds[", vm.toString(i), "]");
            params.rounds[i].codewordLength = vm.parseJsonUint(json, string.concat(prefix, ".codewordLength"));
            params.rounds[i].merkleDepth = vm.parseJsonUint(json, string.concat(prefix, ".merkleDepth"));
            params.rounds[i].domainGenerator = uint64(vm.parseJsonUint(json, string.concat(prefix, ".domainGenerator")));
            params.rounds[i].inDomainSamples = vm.parseJsonUint(json, string.concat(prefix, ".inDomainSamples"));
            params.rounds[i].outDomainSamples = vm.parseJsonUint(json, string.concat(prefix, ".outDomainSamples"));
            params.rounds[i].sumcheckRounds = vm.parseJsonUint(json, string.concat(prefix, ".sumcheckRounds"));
            params.rounds[i].interleavingDepth = vm.parseJsonUint(json, string.concat(prefix, ".interleavingDepth"));
            params.rounds[i].cosetSize = vm.parseJsonUint(json, string.concat(prefix, ".cosetSize"));
            params.rounds[i].numCosets = vm.parseJsonUint(json, string.concat(prefix, ".numCosets"));
            params.rounds[i].numVariables = vm.parseJsonUint(json, string.concat(prefix, ".numVariables"));
            params.rounds[i].powThreshold =
                uint64(vm.parseUint(vm.parseJsonString(json, string.concat(prefix, ".powThreshold"))));
            params.rounds[i].sumcheckPowThreshold =
                uint64(vm.parseUint(vm.parseJsonString(json, string.concat(prefix, ".sumcheckPowThreshold"))));
        }
        string memory roundTail = string.concat(".whirParams.rounds[", vm.toString(numRounds), "].codewordLength");
        try vm.parseJsonUint(json, roundTail) returns (uint256) {
            revert("fixture: WHIR round tail");
        } catch {}

        // Grouped packed WHIR opens four row points. Each is extended by the
        // independently sampled Ext3 constituent-index point before the full
        // dense-LSB point is reversed into WHIR order.
        uint256[] memory rGate = _gatePointFromEvaluationPoint(json);
        uint256[] memory rInv = _parseGoldilocksArray(json, ".invSumcheckChallenges");
        uint256[] memory rH = _parseGoldilocksArray(json, ".hSumcheckChallenges");
        uint256[] memory rGateV2 = _parseGoldilocksArray(json, ".gateSumcheckChallenges");
        GoldilocksExt3.Ext3[][] memory indexPoints = _derivePackedIndexPoints(json);

        params.evaluationPoint = _packedEvaluationPoint(rGate, indexPoints[0]);
        params.evaluationPoint2 = _packedEvaluationPoint(rInv, indexPoints[1]);
        params.additionalEvaluationPoints = new GoldilocksExt3.Ext3[][](2);
        params.additionalEvaluationPoints[0] = _packedEvaluationPoint(rH, indexPoints[2]);
        params.additionalEvaluationPoints[1] = _packedEvaluationPoint(rGateV2, indexPoints[3]);

        return params;
    }

    /// @dev Read sumcheck output point r_gate from the fixture's evaluationPoint
    /// (already embedded as Ext3 with c1=c2=0).
    function _gatePointFromEvaluationPoint(string memory json) internal pure returns (uint256[] memory out) {
        uint256 degreeBits = vm.parseJsonUint(json, ".degreeBits");
        out = new uint256[](degreeBits);
        for (uint256 i = 0; i < degreeBits; i++) {
            string memory base = string.concat(".evaluationPoint[", vm.toString(i), "]");
            out[i] = _parseGoldilocks(json, string.concat(base, ".c0"));
            require(_parseGoldilocks(json, string.concat(base, ".c1")) == 0, "fixture: evaluationPoint c1");
            require(_parseGoldilocks(json, string.concat(base, ".c2")) == 0, "fixture: evaluationPoint c2");
        }
        string memory tail = string.concat(".evaluationPoint[", vm.toString(degreeBits), "].c0");
        try vm.parseJsonString(json, tail) returns (string memory) {
            revert("fixture: evaluationPoint tail");
        } catch {}
    }

    function _derivePackedIndexPoints(string memory json)
        internal
        pure
        returns (GoldilocksExt3.Ext3[][] memory points)
    {
        TranscriptLib.Transcript memory transcript;
        TranscriptLib.init(transcript);
        _replayTranscriptPrefix(transcript, json);

        uint256 degreeBits = vm.parseJsonUint(json, ".degreeBits");
        _replaySumcheck(transcript, json, ".combinedProof", ".evaluationPoint", degreeBits, 3, true);
        TranscriptLib.domainSeparate(transcript, "v2-inv-zerocheck");
        _replaySumcheck(transcript, json, ".invSumcheckProof", ".invSumcheckChallenges", degreeBits, 4, false);
        TranscriptLib.domainSeparate(transcript, "v2-h-linear");
        _replaySumcheck(transcript, json, ".hSumcheckProof", ".hSumcheckChallenges", degreeBits, 2, false);
        TranscriptLib.domainSeparate(transcript, "v2-gate-challenges");
        _squeezeExpectedArray(transcript, _parseExactGoldilocksArray(json, ".tauGate", degreeBits));
        TranscriptLib.domainSeparate(transcript, "v2-gate-zerocheck");
        _replaySumcheck(
            transcript,
            json,
            ".gateSumcheckProof",
            ".gateSumcheckChallenges",
            degreeBits,
            vm.parseJsonUint(json, ".quotientDegreeFactor") + 3,
            false
        );

        TranscriptLib.domainSeparate(transcript, "pcs-eval");
        _absorbPackedClaims(transcript, json);
        TranscriptLib.domainSeparate(transcript, "pcs-constituent-index-v1");

        uint256 indexBits = _ceilLog2(vm.parseJsonUint(json, ".constituentWidth"));
        points = new GoldilocksExt3.Ext3[][](4);
        for (uint256 point = 0; point < 4; point++) {
            points[point] = new GoldilocksExt3.Ext3[](indexBits);
            for (uint256 bit = 0; bit < indexBits; bit++) {
                points[point][bit] = GoldilocksExt3.Ext3(
                    uint64(TranscriptLib.squeezeChallenge(transcript)),
                    uint64(TranscriptLib.squeezeChallenge(transcript)),
                    uint64(TranscriptLib.squeezeChallenge(transcript))
                );
            }
        }
    }

    function _replayTranscriptPrefix(TranscriptLib.Transcript memory transcript, string memory json) internal pure {
        uint256 degreeBits = vm.parseJsonUint(json, ".degreeBits");
        uint256 constituentWidth = vm.parseJsonUint(json, ".constituentWidth");
        TranscriptLib.domainSeparate(transcript, "circuit");
        TranscriptLib.absorbFieldVec(transcript, _parseExactGoldilocksArray(json, ".circuitDigest", 4));
        TranscriptLib.absorbFieldVec(transcript, _parseGoldilocksArray(json, ".publicInputs"));

        TranscriptLib.domainSeparate(transcript, "pcs-schema-packed-v1");
        uint256[10] memory schema = [
            vm.parseJsonUint(json, ".protocolVersion"),
            uint256(4),
            vm.parseJsonUint(json, ".numConstants"),
            vm.parseJsonUint(json, ".numRoutedWires"),
            vm.parseJsonUint(json, ".numWires"),
            constituentWidth,
            _ceilLog2(constituentWidth),
            uint256(1),
            uint256(3),
            uint256(0)
        ];
        for (uint256 i = 0; i < schema.length; i++) {
            TranscriptLib.absorbU64Bytes(transcript, schema[i]);
        }

        TranscriptLib.domainSeparate(transcript, "pcs-group-preprocessed");
        TranscriptLib.absorbBytes(transcript, vm.parseJsonBytes(json, ".preprocessedCommitmentRoot"));
        TranscriptLib.domainSeparate(transcript, "pcs-group-witness");
        TranscriptLib.absorbBytes(transcript, vm.parseJsonBytes(json, ".witnessCommitmentRoot"));
        TranscriptLib.domainSeparate(transcript, "batch-commit-witness");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".witnessBatchR"));
        TranscriptLib.domainSeparate(transcript, "challenges");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".beta"));
        _squeezeExpected(transcript, _parseGoldilocks(json, ".gamma"));
        TranscriptLib.domainSeparate(transcript, "pcs-group-inverse-helpers");
        TranscriptLib.absorbBytes(transcript, vm.parseJsonBytes(json, ".inverseHelpersCommitmentRoot"));
        TranscriptLib.domainSeparate(transcript, "inverse-helpers-batch-r");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".inverseHelpersBatchR"));
        _squeezeExpected(transcript, _parseGoldilocks(json, ".alpha"));
        TranscriptLib.domainSeparate(transcript, "extension-combine");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".extChallenge"));
        TranscriptLib.domainSeparate(transcript, "pcs-group-auxiliary");
        TranscriptLib.absorbBytes(transcript, vm.parseJsonBytes(json, ".auxCommitmentRoot"));
        TranscriptLib.domainSeparate(transcript, "aux-batch-r");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".auxBatchR"));
        TranscriptLib.domainSeparate(transcript, "post-auxiliary-challenges-v1");
        _squeezeExpectedArray(transcript, _parseExactGoldilocksArray(json, ".tau", degreeBits));
        _squeezeExpectedArray(transcript, _parseExactGoldilocksArray(json, ".tauPerm", degreeBits));
        TranscriptLib.domainSeparate(transcript, "v2-logup-challenges");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".lambdaInv"));
        _squeezeExpected(transcript, _parseGoldilocks(json, ".muInv"));
        _squeezeExpectedArray(transcript, _parseExactGoldilocksArray(json, ".tauInv", degreeBits));
        TranscriptLib.domainSeparate(transcript, "combined-sumcheck");
        _squeezeExpected(transcript, _parseGoldilocks(json, ".mu"));
    }

    function _replaySumcheck(
        TranscriptLib.Transcript memory transcript,
        string memory json,
        string memory proofPath,
        string memory challengePath,
        uint256 rounds,
        uint256 evaluationsPerRound,
        bool ext3Point
    ) internal pure {
        uint256[] memory challenges = ext3Point
            ? _gatePointFromEvaluationPoint(json)
            : _parseGoldilocksArray(json, challengePath);
        require(challenges.length == rounds, "fixture: sumcheck challenge length");
        for (uint256 round = 0; round < rounds; round++) {
            TranscriptLib.domainSeparate(transcript, "sumcheck-round");
            string memory roundPath = string.concat(proofPath, ".roundPolys[", vm.toString(round), "]");
            TranscriptLib.absorbFieldVec(transcript, _parseExactGoldilocksArray(json, roundPath, evaluationsPerRound));
            _squeezeExpected(transcript, challenges[round]);
        }
        string memory tail = string.concat(proofPath, ".roundPolys[", vm.toString(rounds), "]");
        try vm.parseJsonStringArray(json, tail) returns (string[] memory) {
            revert("fixture: sumcheck round tail");
        } catch {}
    }

    function _absorbPackedClaims(TranscriptLib.Transcript memory transcript, string memory json) internal pure {
        uint256[] memory empty = new uint256[](0);
        uint256[] memory auxiliary = new uint256[](2);
        uint256 preprocessedLength = vm.parseJsonUint(json, ".numConstants") + vm.parseJsonUint(json, ".numRoutedWires");
        uint256 witnessLength = vm.parseJsonUint(json, ".numWires");
        uint256 inverseLength = 2 * vm.parseJsonUint(json, ".numRoutedWires");
        auxiliary[0] = _parseGoldilocks(json, ".auxConstraintEval");
        auxiliary[1] = _parseGoldilocks(json, ".auxPermEval");
        TranscriptLib.domainSeparate(transcript, "pcs-constituent-claims-v1");
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".preprocessedIndividualEvals", preprocessedLength)
        );
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".witnessIndividualEvals", witnessLength)
        );
        TranscriptLib.absorbFieldVec(transcript, empty);
        TranscriptLib.absorbFieldVec(transcript, auxiliary);
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".preprocessedIndividualEvalsAtRInv", preprocessedLength)
        );
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".witnessIndividualEvalsAtRInv", witnessLength)
        );
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".inverseHelpersEvalsAtRInv", inverseLength)
        );
        TranscriptLib.absorbFieldVec(transcript, empty);
        TranscriptLib.absorbFieldVec(transcript, empty);
        TranscriptLib.absorbFieldVec(transcript, empty);
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".inverseHelpersEvalsAtRH", inverseLength)
        );
        TranscriptLib.absorbFieldVec(transcript, empty);
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".preprocessedIndividualEvalsAtRGateV2", preprocessedLength)
        );
        TranscriptLib.absorbFieldVec(
            transcript, _parseExactGoldilocksArray(json, ".witnessIndividualEvalsAtRGateV2", witnessLength)
        );
        TranscriptLib.absorbFieldVec(transcript, empty);
        TranscriptLib.absorbFieldVec(transcript, empty);
    }

    function _squeezeExpected(TranscriptLib.Transcript memory transcript, uint256 expected) internal pure {
        require(TranscriptLib.squeezeChallenge(transcript) == expected, "fixture: transcript challenge");
    }

    function _squeezeExpectedArray(TranscriptLib.Transcript memory transcript, uint256[] memory expected)
        internal
        pure
    {
        for (uint256 i = 0; i < expected.length; i++) {
            _squeezeExpected(transcript, expected[i]);
        }
    }

    function _ceilLog2(uint256 value) internal pure returns (uint256 bits) {
        require(value != 0, "fixture: zero constituent width");
        value--;
        while (value != 0) {
            bits++;
            value >>= 1;
        }
    }

    function _packedEvaluationPoint(uint256[] memory rowPoint, GoldilocksExt3.Ext3[] memory indexPoint)
        internal
        pure
        returns (GoldilocksExt3.Ext3[] memory point)
    {
        point = new GoldilocksExt3.Ext3[](rowPoint.length + indexPoint.length);
        for (uint256 i = 0; i < indexPoint.length; i++) {
            point[i] = indexPoint[indexPoint.length - 1 - i];
        }
        for (uint256 i = 0; i < rowPoint.length; i++) {
            point[indexPoint.length + i] = GoldilocksExt3.Ext3(uint64(rowPoint[rowPoint.length - 1 - i]), 0, 0);
        }
    }
}
