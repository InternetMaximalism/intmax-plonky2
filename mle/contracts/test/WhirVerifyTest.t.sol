    {
        roots = new bytes32[](NUM_PCS_GROUPS);
        for (uint256 i = 0; i < roots.length; i++) {
            roots[i] = vm.parseJsonBytes32(json, string.concat(base, ".roots[", vm.toString(i), "]"));
        }
