    function _assertHistoricalConstituents(
        uint256[] memory witnessBefore,
        uint256[] memory witnessAfter,
        uint256[] memory inverseBefore,
        uint256[] memory inverseAfter,
        HistoricalExpected memory expected,
        uint256 width
    ) internal pure {
        require(
            witnessBefore.length == width && witnessAfter.length == width && inverseBefore.length == width
                && inverseAfter.length == width,
            "historical PCS constituent length"
        );
        require(witnessBefore[0] == expected.w0Before && witnessAfter[0] == expected.w0After, "historical w0");
        require(witnessBefore[1] == expected.w1 && witnessAfter[1] == expected.w1, "historical w1");
        require(witnessBefore[80] == expected.w80Before && witnessAfter[80] == expected.w80After, "historical w80");
        require(inverseBefore[0] == expected.a0 && inverseAfter[0] == expected.a0, "historical A0");
        require(inverseBefore[1] == expected.a1Before && inverseAfter[1] == expected.a1After, "historical A1");
        require(inverseBefore[80] == expected.b0 && inverseAfter[80] == expected.b0, "historical B0");
        for (uint256 i = 0; i < width; i++) {
            if (i != 0 && i != 80) require(witnessBefore[i] == witnessAfter[i], "extra witness mutation");
            if (i != 1) require(inverseBefore[i] == inverseAfter[i], "extra inverse mutation");
        }
    }

    function _parseHistoricalRoots(string memory json, string memory base)
        internal
