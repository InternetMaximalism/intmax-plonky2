contract WhirRowDecoderHarness {
    function dotOne(bytes calldata row, bool isBaseField) external pure returns (GoldilocksExt3.Ext3 memory) {
        GoldilocksExt3.Ext3[] memory weights = new GoldilocksExt3.Ext3[](1);
        weights[0] = GoldilocksExt3.one();
        SpongefishMerkle.CalldataBytes memory rowView =
            SpongefishMerkle.CalldataBytes({offset: 0, length: row.length});
        assembly ("memory-safe") {
            mstore(rowView, row.offset)
        }
        return SpongefishWhirVerify._dotEqWithRow(weights, rowView, 0, 1, isBaseField);
    }
}

/// @title WhirVerifyTest
/// @notice Tests WHIR verification using fixtures generated by the Rust prover.
///         Uses the v1 grouped-constituent statement exported by the Rust prover.
///         Run: forge test -vvv --match-contract WhirVerifyTest
contract WhirVerifyTest is Test {
    uint256 internal constant P = 0xFFFFFFFF00000001;
    uint256 internal constant HISTORICAL_WIDTH = 160;
    uint256 internal constant HISTORICAL_INDEX_BITS = 8;
    uint256 internal constant HISTORICAL_WITNESS_SLOT = POINT_INVERSE * NUM_PCS_GROUPS + GROUP_WITNESS;
    uint256 internal constant HISTORICAL_INVERSE_SLOT = POINT_INVERSE * NUM_PCS_GROUPS + GROUP_INVERSE_HELPERS;

    struct HistoricalExpected {
        uint256 w0Before;
        uint256 w0After;
        uint256 w1;
        uint256 w80Before;
        uint256 w80After;
        uint256 a0;
        uint256 a1Before;
        uint256 a1After;
        uint256 b0;
    }

    struct HistoricalPcsData {
        bytes protocolId;
        bytes sessionId;
        bytes transcript;
        bytes hints;
        bytes32[] roots;
        SpongefishWhirVerify.WhirParams params;
        GoldilocksExt3.Ext3[] indexPoint;
        GoldilocksExt3.Ext3[] evaluations;
        uint256[] witnessBefore;
        uint256[] witnessAfter;
        uint256[] inverseBefore;
        uint256[] inverseAfter;
    }

    WhirRowDecoderHarness internal immutable rowDecoder = new WhirRowDecoderHarness();

    /// @notice WHIR hints use Arkworks canonical field serialization. Accepting p as an alternate
    ///         encoding of zero would let one field oracle produce multiple Merkle/Fiat-Shamir roots.
    function test_whir_rejects_noncanonical_base_hint_row() public {
        vm.expectRevert();
        rowDecoder.dotOne(hex"01000000ffffffff", true);
    }

    /// @notice Apply the same canonicality rule to every coefficient of an Ext3 hint row.
    function test_whir_rejects_noncanonical_ext3_hint_row() public {
        vm.expectRevert();
        rowDecoder.dotOne(hex"000000000000000001000000ffffffff0000000000000000", false);
    }

