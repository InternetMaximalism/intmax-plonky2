pragma solidity ^0.8.25;

import {Test} from "forge-std/Test.sol";
import {InvalidMleProof} from "../src/MleProofErrors.sol";
import {MleVerifierV2} from "../src/MleVerifierV2.sol";
import {PinnedMleVerifierV2} from "../src/PinnedMleVerifierV2.sol";

/// @notice Cheating-prover regression fixtures for the wire-v3 verifier.
/// @dev Every proof in `v2_cheating_prover.json` has an HONEST WHIR/transcript part: the
/// prover committed tampered evaluation tables, ran both sumchecks over them and opened
/// exactly what it committed. Only the relation check each case targets can reject it:
///   - gate_violation_only           -> `OuterLogupExt3Verifier.verifyGateTerminal` (gate terminal)
///   - copy_constraint_violation_only -> the norm/logUp terminal revert in `verifyPrevalidated`
///   - preprocessed_root_mismatch    -> `proof.preprocessedRoot != preprocessedCommitmentRoot`
///   - public_input_mismatch         -> the norm/logUp terminal (D_PI binding); the gate lane
///                                      is violated as well
/// Deleting one of those checks makes the matching case verify, which no perturbed-honest-proof
/// test in this suite can detect because the WHIR/transcript check fires first for them.
/// The fixture is generated by `mle/tests/cheating_prover_fixtures.rs` through a non-verifying
/// export path; regenerate it with
/// `cargo test -p plonky2_mle --test cheating_prover_fixtures regenerate_v2_cheating_prover_fixture -- --ignored`.
contract CheatingProverFixtureV2Test is Test {
    string internal constant FIXTURE = "test/fixtures/v2_cheating_prover.json";
    string internal constant SCHEMA = "plonky2-mle-cheating-prover-fixture-v3";
    uint256 internal constant CASE_COUNT = 4;
    uint8 internal constant VERDICT_INVALID = 0;
    uint8 internal constant VERDICT_PI_MISMATCH = 4;
    /// @dev Same production block envelope `V2ResourceEnvelope` enforces: a conviction that
    /// needs more than this could never be reached by a real fraud transaction.
    uint256 internal constant MAX_PRODUCTION_VERIFY_GAS = 30_000_000;

    struct Deployment {
        MleVerifierV2 core;
        PinnedMleVerifierV2 pinned;
        MleVerifierV2.VerificationConfig config;
        bytes32 preprocessedRoot;
        uint64[4] circuitDigest;
    }

    struct ProofRecord {
        string name;
        MleVerifierV2.MleProof proof;
        bytes abiBytes;
        bytes compact;
    }

    // ------------------------------------------------------------------
    // Positive control
    // ------------------------------------------------------------------

    function test_honestControlFromTheSameTablesVerifies() external {
        string memory json = vm.readFile(FIXTURE);
        Deployment memory deployment = _deploy(json);
        ProofRecord memory honest = _loadProof(json, ".honest");

        assertEq(honest.proof.preprocessedRoot, deployment.preprocessedRoot, "honest proof commits the VK root");
        assertTrue(deployment.core.verify(honest.proof, deployment.config), "honest ABI proof");
        assertTrue(deployment.pinned.verifyCompact(honest.compact), "honest compact proof");
        uint256[] memory publicInputs = deployment.pinned.verifyCompactPublicInputs(honest.compact);
        assertEq(publicInputs.length, honest.proof.publicInputs.length, "authenticated public input count");
        for (uint256 i = 0; i < publicInputs.length; ++i) {
            assertEq(publicInputs[i], honest.proof.publicInputs[i], "authenticated public input");
        }
        // The small-mul circuit has one public input, not the eight-limb rollup
        // shape, so a VALID core result classifies as PI_MISMATCH (never INVALID).
        assertEq(
            deployment.pinned.fraudVerdictCompact(honest.compact, bytes32(0)),
            VERDICT_PI_MISMATCH,
            "honest control must not convict"
        );
    }

    // ------------------------------------------------------------------
    // Cheating provers: one test per targeted check
    // ------------------------------------------------------------------

    /// @dev Caught only by the Ext3 gate terminal (`verifyGateTerminal` call in `_verifyAtomic`).
    function test_gateViolationOnlyIsRejected() external {
        _assertCheatingCaseRejected(0, "gate_violation_only", true);
    }

    /// @dev Caught only by the norm/logUp terminal revert in `verifyPrevalidated`.
    function test_copyConstraintViolationOnlyIsRejected() external {
        _assertCheatingCaseRejected(1, "copy_constraint_violation_only", true);
    }

    /// @dev Caught only by the preprocessed-root pin in `_requireCanonicalProof`: the prover
    /// committed (and WHIR-opened) a rerouted sigma table that the honest witness satisfies.
    function test_preprocessedRootMismatchIsRejected() external {
        _assertCheatingCaseRejected(2, "preprocessed_root_mismatch", false);
    }

    /// @dev Caught by the norm/logUp terminal (public-input binding); the gate lane also fails.
    function test_publicInputMismatchIsRejected() external {
        _assertCheatingCaseRejected(3, "public_input_mismatch", true);
    }

    /// @dev The fixture really isolates the targeted check: every cheating proof shares the
    /// honest circuit digest, public-input shape and (except the root case) the honest
    /// preprocessed root, and the recorded Rust verdicts name the intended check.
    function test_fixtureShapeIsolatesOneCheckPerCase() external view {
        string memory json = vm.readFile(FIXTURE);
        assertEq(vm.parseJsonString(json, ".schema"), SCHEMA, "fixture schema");
        ProofRecord memory honest = _loadProof(json, ".honest");
        bytes32 honestRoot = vm.parseJsonBytes32(json, ".pinnedVerifier.preprocessedCommitmentRoot");
        assertEq(honest.proof.preprocessedRoot, honestRoot, "honest root is the VK pin");

        string[CASE_COUNT] memory expectedErrors = [
            "gate terminal equation failed",
            "norm/logUp terminal equation failed",
            "preprocessed root is not VK-bound",
            "norm/logUp terminal equation failed"
        ];
        for (uint256 i = 0; i < CASE_COUNT; ++i) {
            string memory path = _casePath(i);
            ProofRecord memory record = _loadProof(json, path);
            assertEq(
                vm.parseJsonString(json, string.concat(path, ".expectedRustError")),
                expectedErrors[i],
                "recorded native verdict"
            );
            bool rootMatches = vm.parseJsonBool(json, string.concat(path, ".preprocessedRootMatchesVk"));
            assertEq(record.proof.preprocessedRoot == honestRoot, rootMatches, "recorded root-pin expectation");
            assertEq(record.proof.circuitDigest.length, 4, "circuit digest length");
            for (uint256 j = 0; j < 4; ++j) {
                assertEq(record.proof.circuitDigest[j], honest.proof.circuitDigest[j], "honest circuit digest");
            }
            assertEq(record.proof.publicInputs.length, honest.proof.publicInputs.length, "public input count");
            assertEq(record.proof.constituentWidth, honest.proof.constituentWidth, "constituent width");
        }
    }

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function _assertCheatingCaseRejected(uint256 index, string memory expectedName, bool rootMatchesVk) private {
        string memory json = vm.readFile(FIXTURE);
        Deployment memory deployment = _deploy(json);
        ProofRecord memory record = _loadProof(json, _casePath(index));
        assertEq(record.name, expectedName, "case name");
        assertEq(record.proof.preprocessedRoot == deployment.preprocessedRoot, rootMatchesVk, "root pin expectation");

        vm.expectRevert(InvalidMleProof.selector);
        deployment.core.verify(record.proof, deployment.config);

        vm.expectRevert(InvalidMleProof.selector);
        deployment.pinned.verifyCompact(record.compact);

        vm.expectRevert(InvalidMleProof.selector);
        deployment.pinned.verifyCompactPublicInputs(record.compact);

        uint256 beforeGas = gasleft();
        uint8 verdict = deployment.pinned.fraudVerdictCompact(record.compact, bytes32(0));
        uint256 used = beforeGas - gasleft();
        emit log_named_string("case", record.name);
        emit log_named_uint("fraudVerdictCompact gas", used);
        assertEq(verdict, VERDICT_INVALID, "cheating proof must convict");
        assertLt(used, MAX_PRODUCTION_VERIFY_GAS, "conviction must fit the production gas envelope");
    }

    function _casePath(uint256 index) private pure returns (string memory) {
        return string.concat(".cases[", vm.toString(index), "]");
    }

    function _loadProof(string memory json, string memory path) private pure returns (ProofRecord memory record) {
        record.name = vm.parseJsonString(json, string.concat(path, ".name"));
        record.abiBytes = _loadEncoded(json, string.concat(path, ".solidityAbiProof"));
        record.compact = _loadEncoded(json, string.concat(path, ".compactProof"));
        record.proof = abi.decode(record.abiBytes, (MleVerifierV2.MleProof));
    }

    function _loadEncoded(string memory json, string memory path) private pure returns (bytes memory encoded) {
        encoded = vm.parseJsonBytes(json, string.concat(path, ".bytes"));
        assertEq(encoded.length, vm.parseJsonUint(json, string.concat(path, ".byteLength")), "recorded byte length");
        assertEq(keccak256(encoded), vm.parseJsonBytes32(json, string.concat(path, ".keccak256")), "recorded keccak");
    }

    /// @dev Exactly the `V2CrossLanguageFixture` / `V2ResourceEnvelope` deployment: the honest
    /// VK pins and the honest ABI-encoded verification config.
    function _deploy(string memory json) private returns (Deployment memory deployment) {
        bytes memory configAbi = _loadEncoded(json, ".solidityAbiVerificationConfig");
        deployment.config = abi.decode(configAbi, (MleVerifierV2.VerificationConfig));
        deployment.preprocessedRoot = vm.parseJsonBytes32(json, ".pinnedVerifier.preprocessedCommitmentRoot");

        bytes memory protocolId = vm.parseJsonBytes(json, ".pinnedVerifier.whirProtocolId");
        assertEq(protocolId.length, 64, "WHIR protocol identifier length");
        bytes32 first;
        bytes32 second;
        assembly ("memory-safe") {
            first := mload(add(protocolId, 0x20))
            second := mload(add(protocolId, 0x40))
        }
        bytes32 sessionId = vm.parseJsonBytes32(json, ".pinnedVerifier.whirSessionId");

        string[] memory digest = vm.parseJsonStringArray(json, ".pinnedVerifier.circuitDigest");
        assertEq(digest.length, 4, "circuit digest length");
        for (uint256 i = 0; i < 4; ++i) {
            deployment.circuitDigest[i] = uint64(vm.parseUint(digest[i]));
        }

        deployment.core = new MleVerifierV2(
            block.chainid,
            deployment.preprocessedRoot,
            [first, second],
            sessionId,
            deployment.circuitDigest,
            deployment.config
        );
        deployment.pinned = new PinnedMleVerifierV2(deployment.core, deployment.config);
    }
}
